generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PendingVerification
  Active
  Suspended
  Banned
  Deactivated
}

enum ProfileVisibility {
  Public
  Private
  Unlisted
}

enum ContactPreference {
  DirectMessage
  Email
  Phone
}

enum BookingPreference {
  OpenToBooking
  InquireFirst
  NotAvailable
}

enum SkillLevel {
  Beginner
  Intermediate
  Advanced
  Professional
}

enum MediaCategory {
  Avatar
  Cover
  Portfolio
  Post
  Audio
  Video
  VoiceNote
  Document
  Organization
  Group
}

enum MediaVisibility {
  Public
  Private
}

enum MediaUploadStatus {
  Pending
  Uploaded
  Failed
}

enum CommunityType {
  Public
  Private
}

enum MembershipStatus {
  Pending
  Active
  Rejected
  Banned
  Left
}

enum MembershipRole {
  Owner
  Admin
  Moderator
  Member
}

enum OpportunityApplicationStatus {
  Pending
  Accepted
  Rejected
  Withdrawn
}

enum BookingStatus {
  Pending
  Accepted
  Declined
  Cancelled
  Completed
}

enum PostType {
  Text
  Image
  Video
  Audio
  Poll
  Announcement
}

enum ReactionType {
  Like
  Love
  Celebrate
  Support
}

enum ConversationType {
  Direct
  Community
  Group
  Organization
  Booking
}

enum MessageType {
  Text
  Image
  Video
  Audio
  Document
  System
}

enum NotificationType {
  NewMessage
  NewFollower
  ConnectionRequest
  Opportunity
  ApplicationReceived
  ApplicationUpdate
  GroupInvitation
  BookingRequest
  BookingProposal
  BookingConfirmation
  BookingCancellation
  Review
  CommunityAnnouncement
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  fullName              String
  username              String     @unique
  email                 String     @unique
  phone                 String?
  avatarUrl             String?
  passwordHash          String
  accountType           String     @default("Musician")
  accountTypeSelectedAt DateTime?
  onboardingStep        Int        @default(1)
  onboardingCompletedAt DateTime?
  avatarMediaId         String?    @db.Uuid
  status                UserStatus @default(PendingVerification)
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  roles                   UserRole[]
  sessions                UserSession[]
  refreshTokens           RefreshToken[]
  emailTokens             EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  preferences             UserPreference?
  blockedUsers            UserBlock[]              @relation("BlockedUsers")
  blockedByUsers          UserBlock[]              @relation("BlockedByUsers")
  profile                 MusicianProfile?
  mediaAssets             MediaAsset[]
  ownedOrganizations      Organization[]
  professions             MusicianProfession[]
  instruments             MusicianInstrument[]
  genres                  MusicianGenre[]
  availability            MusicianAvailability[]
  portfolioItems          PortfolioItem[]
  profileRates            ProfileRate[]
  profileLocation         ProfileLocation?
  organizationMemberships OrganizationMember[]
  verificationRecords     VerificationRecord[]
  verificationDocuments   VerificationDocument[]
  createdCommunities      Community[]              @relation("CommunityOwner")
  communityMemberships    CommunityMember[]
  posts                   Post[]                   @relation("PostAuthor")
  comments                Comment[]                @relation("CommentAuthor")
  postReactions           PostReaction[]           @relation("PostReactions")
  commentReactions        CommentReaction[]        @relation("CommentReactions")
  pollVotes               PollVote[]
  postReports             PostReport[]             @relation("PostReportReporter")
  conversationMemberships ConversationMember[]     @relation("UserConversationMembership")
  sentMessages            Message[]                @relation("MessageSender")
  messageReactions        MessageReaction[]        @relation("MessageReactionAuthor")
  notifications           Notification[]           @relation("UserNotifications")
  ownedGroups             MusicGroup[]             @relation("MusicGroupOwner")
  groupMemberships        MusicGroupMember[]
  hostedOpportunities     Opportunity[]            @relation("OpportunityOrganizer")
  opportunityApplications OpportunityApplication[]
  bookingRequestsSent     BookingRequest[]         @relation("BookingRequester")
  bookingRequestsReceived BookingRequest[]         @relation("BookingMusician")
  savedOpportunities      SavedOpportunity[]
  following               UserFollow[]             @relation("UserFollowing")
  followers               UserFollow[]             @relation("UserFollowers")
  messageReceipts         MessageReceipt[]         @relation("MessageReceiptRecipient")

  @@index([email])
  @@index([username])
  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshToken String?
  userAgent    String?
  ipAddress    String?
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  sessionId           String?   @db.Uuid
  tokenHash           String
  revokedAt           DateTime?
  replacedByTokenHash String?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model UserPreference {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  theme             String   @default("light")
  emailAlerts       Boolean  @default(true)
  pushNotifications Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  reason    String?
  createdAt DateTime @default(now())

  blocker User @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model MusicianProfile {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @unique @db.Uuid
  stageName         String?
  headline          String?
  biography         String?
  experience        Int?
  skillLevel        SkillLevel?
  country           String?
  province          String?
  district          String?
  city              String?
  socialLinks       Json?
  customGenres      String[]          @default([])
  visibility        ProfileVisibility @default(Public)
  contactPreference ContactPreference @default(DirectMessage)
  bookingPreference BookingPreference @default(OpenToBooking)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility])
}

model Organization {
  id                 String   @id @default(uuid()) @db.Uuid
  ownerId            String   @db.Uuid
  name               String
  type               String?
  description        String?
  logoUrl            String?
  coverImageUrl      String?
  location           String?
  country            String?
  city               String?
  physicalAddress    String?
  website            String?
  socialLinks        Json?
  registrationNumber String?
  establishedYear    Int?
  email              String?
  phone              String?
  isActive           Boolean  @default(true)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  verifications OrganizationVerification[]
  opportunities Opportunity[]
  posts         Post[]

  @@index([ownerId])
}

model MediaAsset {
  id               String            @id @default(uuid()) @db.Uuid
  ownerId          String            @db.Uuid
  objectKey        String
  originalFilename String
  mimeType         String
  fileSize         Int
  category         MediaCategory
  visibility       MediaVisibility   @default(Private)
  uploadStatus     MediaUploadStatus @default(Pending)
  url              String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([uploadStatus])
  @@index([visibility])
}

model Profession {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  musicianProfiles MusicianProfession[]

  @@index([name])
}

model Instrument {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  musicianProfiles MusicianInstrument[]

  @@index([name])
}

model Genre {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  musicianProfiles MusicianGenre[]

  @@index([name])
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  country   String
  province  String?
  district  String?
  city      String?
  sector    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([province])
}

model MusicianProfession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  professionId String   @db.Uuid
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([userId, professionId])
  @@index([userId])
}

model MusicianInstrument {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  instrumentId    String      @db.Uuid
  skillLevel      SkillLevel?
  yearsExperience Int?
  createdAt       DateTime    @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
  @@index([userId])
}

model MusicianGenre {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  genreId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([userId, genreId])
  @@index([userId])
}

model MusicianAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  dayOfWeek   String
  startTime   String?
  endTime     String?
  timezone    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PortfolioItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  mediaUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProfileRate {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  amount      Decimal
  currency    String   @default("RWF")
  rateType    String   @default("hourly")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProfileLocation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  country   String?
  province  String?
  district  String?
  city      String?
  sector    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrganizationMember {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @db.Uuid
  userId                   String    @db.Uuid
  role                     String
  status                   String    @default("Active")
  title                    String?
  authorizationConfirmedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model OrganizationInvitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  inviterId      String   @db.Uuid
  inviteeId      String   @db.Uuid
  role           String
  status         String   @default("Pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrganizationVerification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  status         String    @default("Pending")
  notes          String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model VerificationRecord {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       String
  status     String    @default("NotSubmitted")
  notes      String?
  reviewedBy String?
  reviewedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model VerificationDocument {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  recordId  String   @db.Uuid
  objectKey String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordId])
}

model Community {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @db.Uuid
  name        String
  description String?
  type        CommunityType @default(Public)
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner   User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CommunityMember[]
  rules   CommunityRule[]
  posts   Post[]
  groups  MusicGroup[]

  @@index([ownerId])
}

model CommunityMember {
  id          String           @id @default(uuid()) @db.Uuid
  communityId String           @db.Uuid
  userId      String           @db.Uuid
  role        MembershipRole   @default(Member)
  status      MembershipStatus @default(Active)
  joinedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
}

model CommunityRule {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @db.Uuid
  title       String?
  content     String
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
}

model Post {
  id             String   @id @default(uuid()) @db.Uuid
  authorId       String   @db.Uuid
  communityId    String?  @db.Uuid
  organizationId String?  @db.Uuid
  type           PostType @default(Text)
  content        String?
  isPinned       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author       User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community    Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  media        PostMedia[]
  comments     Comment[]
  reactions    PostReaction[]
  poll         Poll?
  reports      PostReport[]

  @@index([authorId])
  @@index([communityId])
  @@index([organizationId])
}

model PostMedia {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  mediaUrl  String
  mimeType  String?
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @db.Uuid
  authorId        String   @db.Uuid
  parentCommentId String?  @db.Uuid
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User              @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentComment Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       Comment[]         @relation("CommentReplies")
  reactions     CommentReaction[]

  @@index([postId])
  @@index([authorId])
}

model PostReaction {
  id        String       @id @default(uuid()) @db.Uuid
  postId    String       @db.Uuid
  userId    String       @db.Uuid
  type      ReactionType @default(Like)
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CommentReaction {
  id        String       @id @default(uuid()) @db.Uuid
  commentId String       @db.Uuid
  userId    String       @db.Uuid
  type      ReactionType @default(Like)
  createdAt DateTime     @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Poll {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @unique @db.Uuid
  question  String
  createdAt DateTime @default(now())

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @db.Uuid
  text      String
  createdAt DateTime @default(now())

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @db.Uuid
  optionId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

model PostReport {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @db.Uuid
  reporterId String   @db.Uuid
  reason     String
  status     String   @default("Open")
  createdAt  DateTime @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation("PostReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType @default(Direct)
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members       ConversationMember[] @relation("ConversationParticipants")
  messages      Message[]
  notifications Notification[]
  musicGroup    MusicGroup?
}

model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  muted          Boolean   @default(false)
  leftAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation("ConversationParticipants", fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("UserConversationMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  type           MessageType @default(Text)
  content        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions    MessageReaction[] @relation("MessageReactions")
  receipts     MessageReceipt[]

  @@index([conversationId])
  @@index([senderId])
}

model MessageReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @db.Uuid
  userId      String    @db.Uuid
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReceiptRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  type      String   @default("Like")
  createdAt DateTime @default(now())

  message Message @relation("MessageReactions", fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(NewMessage)
  content   String
  isRead    Boolean          @default(false)
  entityId  String?          @db.Uuid
  actionUrl String?
  createdAt DateTime         @default(now())

  user         User          @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model MusicGroup {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  type           String?
  ownerId        String   @db.Uuid
  communityId    String?  @db.Uuid
  conversationId String?  @unique @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User               @relation("MusicGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  community    Community?         @relation(fields: [communityId], references: [id], onDelete: SetNull)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  members      MusicGroupMember[]

  @@index([ownerId])
  @@index([communityId])
}

model MusicGroupMember {
  id        String           @id @default(uuid()) @db.Uuid
  groupId   String           @db.Uuid
  userId    String           @db.Uuid
  status    MembershipStatus @default(Active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group MusicGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, status])
}

model Opportunity {
  id             String    @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  organizerId    String    @db.Uuid
  organizationId String?   @db.Uuid
  location       String?
  eventDate      DateTime?
  startTime      DateTime?
  endTime        DateTime?
  deadline       DateTime?
  budget         Decimal?
  currency       String    @default("RWF")
  status         String    @default("Open")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizer    User                     @relation("OpportunityOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  applications OpportunityApplication[]
  savedBy      SavedOpportunity[]

  @@index([organizerId])
  @@index([organizationId])
}

model OpportunityApplication {
  id            String                       @id @default(uuid()) @db.Uuid
  opportunityId String                       @db.Uuid
  applicantId   String                       @db.Uuid
  coverLetter   String?
  reviewMessage String?
  status        OpportunityApplicationStatus @default(Pending)
  appliedAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant   User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, applicantId])
  @@index([applicantId, status])
}

model BookingRequest {
  id          String        @id @default(uuid()) @db.Uuid
  requesterId String        @db.Uuid
  musicianId  String        @db.Uuid
  eventTitle  String
  description String?
  eventDate   DateTime
  location    String?
  budget      Decimal?      @db.Decimal(12, 2)
  currency    String        @default("RWF")
  responseMessage String?
  status      BookingStatus @default(Pending)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  requester User @relation("BookingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  musician  User @relation("BookingMusician", fields: [musicianId], references: [id], onDelete: Cascade)

  @@index([requesterId, status, createdAt])
  @@index([musicianId, status, createdAt])
}

model SavedOpportunity {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  opportunityId String   @db.Uuid
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId, createdAt])
}

model UserFollow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}
