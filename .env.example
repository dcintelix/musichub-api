# APPLICATION
NODE_ENV=development
PORT=3000
APP_NAME=""
APP_PUBLIC_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3001"

# DATABASE
# Tune Prisma's PostgreSQL pool per application instance with URL parameters
# such as connection_limit and pool_timeout. Account for all replicas when sizing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rwanda_music_hub?schema=public"

# JWT
JWT_ACCESS_SECRET="replace-with-strong-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# RESEND
RESEND_API_KEY="replace-with-resend-key"
EMAIL_FROM="no-reply@example.com"

# CLOUDFLARE R2
STORAGE_PROVIDER="cloudflare_r2"
CF_ACCOUNT_ID=""
CF_ACCESS_KEY=""
CF_SECRET_KEY=""
CF_R2_BUCKET=""
CF_R2_REGION="auto"
# Cloudflare S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
CF_R2_ENDPOINT=""
# Public bucket URL or custom-domain base URL
CF_R2_PUBLIC_URL=""

# CORS
CORS_ORIGINS="http://localhost:3001"

# OPTIONAL REDIS
REDIS_URL=""

# LOGGING
LOG_LEVEL="debug"
